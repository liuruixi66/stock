# 复制为 backend/.env 后按需填写；.env 已被 .gitignore 忽略，不要提交真实凭据。

# ---- 实盘总开关：不设为 1 时，所有 trading_mode=LIVE 的账户都会拒绝下单 ----
LIVE_TRADING_ENABLED=0

# ---- 富途 OpenD（A股/美股模拟盘，美股/A股通实盘）----
# 1. 注册富途牛牛或 moomoo 账号，开通模拟交易；2. 下载 OpenD 并登录；3. pip install futu-api
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
# FUTUSECURITIES(富途香港) / FUTUINC(moomoo 美国) / FUTUSG / FUTUAU / FUTUCA / FUTUMY / FUTUJP
FUTU_SECURITY_FIRM=FUTUSECURITIES
# 仅实盘需要：交易密码，用于 unlock_trade；模拟盘留空
FUTU_TRADE_PASSWORD=

# ---- 盈透 IBKR（美股模拟/实盘）----
# 模拟账号：TWS 7497 / IB Gateway 4002；实盘：TWS 7496 / IB Gateway 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

# ---- 迅投 QMT / miniQMT（A股券商模拟/实盘，仅 Windows）----
# QMT 客户端安装目录下的 userdata_mini；资金账号填写在创建账户时的 broker_account_id
QMT_USERDATA_PATH=D:/国金QMT交易端模拟/userdata_mini
QMT_SESSION_ID=0
